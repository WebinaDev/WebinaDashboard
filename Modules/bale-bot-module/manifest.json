          "path": "/bots/bale",
          "capability": "manage_woocommerce",
          "requires_woocommerce": true
        }
      ]
    },
    {
      "parent_id": "marketing",
      "nodes": [
        {
          "id": "bot-broadcast",
          "title": "Bot broadcast",
          "path": "/marketing/bot-broadcast",
          "capability": "manage_woocommerce"
        },
        {
          "id": "bot-campaigns",
          "title": "Bot campaigns",
          "path": "/marketing/bot-campaigns",
          "capability": "manage_woocommerce"
        }
      ]
    }
  ],
  "client": {
    "entry": "client/dist/module.js",
    "routes": [
      {
        "path": "bots/bale",
        "capability": "manage_woocommerce",
        "headerTitleKey": "bots.baleTitle"
      },
      {
        "path": "marketing/bot-broadcast",
        "capability": "manage_woocommerce",
        "headerTitleKey": "marketing.botBroadcast"
      },
      {
        "path": "marketing/bot-campaigns",
        "capability": "manage_woocommerce",
        "headerTitleKey": "marketing.botCampaigns"
      }
    ]
  }
}
