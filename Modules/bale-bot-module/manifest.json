{
  "slug": "bale-bot-module",
  "name": "Bale shop bot",
  "version": "1.0.0",
  "is_builtin": true,
  "bootstrap": "bootstrap.php",
  "settings": {
    "area": "shop",
    "title": "Bale bot",
    "sections": [
      {
        "id": "dashboard",
        "route": "/bots/bale",
        "title": "Bale bot"
      }
    ]
  },
  "sidebar": [
    {
      "parent_id": "bots",
      "nodes": [
        {
          "id": "bale-bot-module",
