{
  "slug": "bale-pay-gateway-module",
  "name": "Bale Pay Gateway",
  "version": "1.0.0",
  "is_builtin": true,
  "is_first_party": true,
  "parent_slug": "payment-module",
  "requires_woocommerce": true,
  "bootstrap": "bootstrap.php",
