      { "id": "company", "route": "/settings/shop/accounting/company", "title": "Company", "titleKey": "accounting.settings.company" },
      { "id": "sync", "route": "/settings/shop/accounting/sync", "title": "Sync", "titleKey": "accounting.settings.sync" },
      { "id": "tax", "route": "/settings/shop/accounting/tax", "title": "Tax mapping", "titleKey": "accounting.settings.tax" },
      { "id": "hesabfa", "route": "/settings/shop/accounting/hesabfa", "title": "Hesabfa", "titleKey": "accounting.settings.hesabfa" },
      { "id": "payroll", "route": "/settings/shop/accounting/payroll", "title": "Payroll / Tamin", "titleKey": "accounting.settings.payroll" }
    ]
  },
  "sidebar": {
