      { "path": "settings/shop/accounting/sync", "capability": ["manage_woocommerce", "webino_manage_accounting"], "headerTitleKey": "accounting.settings.sync" },
      { "path": "settings/shop/accounting/tax", "capability": ["manage_woocommerce", "webino_manage_accounting"], "headerTitleKey": "accounting.settings.tax" },
      { "path": "settings/shop/accounting/hesabfa", "capability": ["manage_woocommerce", "webino_manage_accounting"], "headerTitleKey": "accounting.settings.hesabfa" },
      { "path": "settings/shop/accounting/payroll", "capability": ["manage_woocommerce", "webino_manage_accounting"], "headerTitleKey": "accounting.settings.payroll" }
