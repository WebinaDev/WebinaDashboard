      { "id": "accounting-reports", "title": "Reports", "path": "/accounting/reports", "capability": "view_woocommerce_reports", "exclude_from_module_toggle": true },
      { "id": "accounting-tools", "title": "Tools", "path": "/accounting/tools", "capability": "webino_manage_accounting", "exclude_from_module_toggle": true }
