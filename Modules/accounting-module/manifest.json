{
  "slug": "accounting-module",
  "name": "Accounting",
  "version": "1.4.0",
  "is_builtin": true,
  "is_first_party": true,
  "requires_woocommerce": true,
  "bootstrap": "bootstrap.php",
  "settings": {
    "area": "shop",
    "title": "Accounting",
    "sections": [
