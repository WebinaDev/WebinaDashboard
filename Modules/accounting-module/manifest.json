      { "id": "accounting-installments", "title": "Installments", "path": "/accounting/installments", "capability": "webino_manage_accounting", "exclude_from_module_toggle": true },
      { "id": "accounting-warehouses", "title": "Warehouses", "path": "/accounting/warehouses", "capability": "webino_manage_accounting", "exclude_from_module_toggle": true },
      { "id": "accounting-production", "title": "Production", "path": "/accounting/production", "capability": "webino_manage_accounting", "exclude_from_module_toggle": true },
      { "id": "accounting-moadian", "title": "Moadian", "path": "/accounting/moadian", "capability": "webino_manage_accounting", "exclude_from_module_toggle": true },
